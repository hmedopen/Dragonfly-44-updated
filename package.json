{
  "name": "folio-script",
  "productName": "Folio Script",
  "description": "Folio Script — Elite Manga & Comic Scanlation Studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "package:exe": "npm run build && electron-packager . \"Folio Script\" --platform=win32 --arch=x64 --icon=public/icon.ico --out=dist-app --overwrite --prune=true",
    "lint": "oxlint",
    "test:diagnostics": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/dev/system-diagnostics/test/*.test.ts",
    "test:local-ocr": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/test/localOcr/*.test.ts",
    "test:manual-selection": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/features/manual-selection/tests/*.test.ts",
    "test:chapter-snatch": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/features/chapter-snatch/tests/*.test.ts",
    "smoke:local-ocr": "node --import ./src/test/localOcr/tsResolveHook.mjs src/test/localOcr/smokeTest.mjs",
    "validate:local-ocr": "node --import ./src/test/localOcr/tsResolveHook.mjs src/test/localOcr/multilingualValidation.mjs",
    "test:phase3": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/test/phase3EndToEnd.test.ts",
    "test:e2e": "node --import ./src/test/localOcr/tsResolveHook.mjs --test src/test/hybridScanIntegration.test.ts src/test/visualInterpretation.test.ts src/test/phase3EndToEnd.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.0",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
